<?php
session_start();
if (empty($_SESSION['msmbilisim_adminlogin'])) {
    header('Location: login.php');
    exit;
}
require_once __DIR__ . '/config/database.php';

$cronDir  = __DIR__ . '/cron';
$cronDir2 = __DIR__ . '/cronjobs';
$basePath = __DIR__;

$allCrons = [];
foreach ([$cronDir, $cronDir2] as $dir) {
    if (!is_dir($dir)) continue;
    $label = basename(dirname($dir)) . '/' . basename($dir);
    foreach (glob($dir . '/*.php') as $file) {
        $allCrons[] = ['path' => $file, 'name' => basename($file), 'dir' => $dir, 'label' => $label];
    }
}
sort($allCrons);

$output = '';
$runFile = $_POST['run_file'] ?? '';
if ($runFile) {
    $safe = realpath($runFile);
    $allowed = array_merge(
        array_map('realpath', glob($cronDir . '/*.php')),
        array_map('realpath', glob($cronDir2 . '/*.php'))
    );
    if ($safe && in_array($safe, $allowed)) {
        $cmd = '/usr/local/bin/php ' . escapeshellarg($safe) . ' 2>&1';
        $output = shell_exec($cmd) ?: '(no output)';
    } else {
        $output = 'ERROR: Invalid file.';
    }
}
?>
