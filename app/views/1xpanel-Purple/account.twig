{% include 'header2.twig' %}

<div class="app-content">
			<div class="page-head">
			   <div class="page-head-bg">
					<svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svgjs="http://svgjs.dev/svgjs" width="100%" height="250" preserveAspectRatio="none" viewBox="0 0 1440 250"><g mask="url(&quot;#SvgjsMask1003&quot;)" fill="none"><path d="M36 250L286 0L604 0L354 250z" fill="url(&quot;#SvgjsLinearGradient1004&quot;)"></path><path d="M258.6 250L508.6 0L634.6 0L384.6 250z" fill="url(&quot;#SvgjsLinearGradient1004&quot;)"></path><path d="M484.20000000000005 250L734.2 0L956.2 0L706.2 250z" fill="url(&quot;#SvgjsLinearGradient1004&quot;)"></path><path d="M740.8000000000001 250L990.8000000000001 0L1311.8000000000002 0L1061.8000000000002 250z" fill="url(&quot;#SvgjsLinearGradient1004&quot;)"></path><path d="M1428 250L1178 0L866 0L1116 250z" fill="url(&quot;#SvgjsLinearGradient1005&quot;)"></path><path d="M1157.4 250L907.4000000000001 0L788.9000000000001 0L1038.9 250z" fill="url(&quot;#SvgjsLinearGradient1005&quot;)"></path><path d="M961.8 250L711.8 0L572.3 0L822.3 250z" fill="url(&quot;#SvgjsLinearGradient1005&quot;)"></path><path d="M691.1999999999999 250L441.19999999999993 0L214.69999999999993 0L464.69999999999993 250z" fill="url(&quot;#SvgjsLinearGradient1005&quot;)"></path><path d="M1199.0621593075448 250L1440 9.062159307544675L1440 250z" fill="url(&quot;#SvgjsLinearGradient1004&quot;)"></path><path d="M0 250L240.93784069245532 250L 0 9.062159307544675z" fill="url(&quot;#SvgjsLinearGradient1005&quot;)"></path></g><defs><mask id="SvgjsMask1003"><rect width="1440" height="250" fill="#ffffff"></rect></mask><linearGradient x1="0%" y1="100%" x2="100%" y2="0%" id="SvgjsLinearGradient1004"><stop stop-color="var(--mc)" offset="0"></stop><stop stop-opacity="0" stop-color="var(--main-bg)" offset="0.66"></stop></linearGradient></defs></svg>
			   </div>
			</div>
		
       
		<!-- Main variables *content* -->
				<div class="container-fluid container-dashboard">
    <div class="top-box">
        <div class="top-box-left">
            <div class="top-avatar" data-toggle="tooltip" title="" data-original-title="Change Avatar">
                <span data-sm="avatar" data-toggle="modal" data-target="#avatarModal"></span>
                <div class="pick-avatar">
                    <i class="fas fa-pencil"></i>
                </div>
            </div>
            <div class="top-text">
                <h4><span>{{ user['username'] }}</span> <div class="alert alert-warning">NEW</div></h4>
                <p>{{ user['email'] }}</p>
            </div>
        </div>
       <!----<button class="btn btn-primary d-flex align-items-center" id="changeEmailLink" data-toggle="modal" data-target="#changeEmailModal">
            <i class="fas fa-at me-2"></i><strong>Change email</strong>
        </button>--->
    </div>

    {% if error %}
        <div class="alert alert-dismissible alert-danger mt-3">
            <button type="button" class="close" data-dismiss="alert">×</button>
            {{ errorText }}
        </div>
    {% endif %}
    {% if success %}
        <div class="alert alert-dismissible alert-success mt-3">
            <button type="button" class="close" data-dismiss="alert">×</button>
            {{ successText }}
        </div>
    {% endif %}

    <div class="account-area mt-4">
        <div class="account-menu">
            <ul class="nav" id="tabAccount" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="security-tab" data-toggle="tab" href="#security" role="tab">
                        <i class="fas fa-shield-alt"></i> Security
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="twofa-tab" data-toggle="tab" href="#twofa" role="tab">
                        <i class="fas fa-qrcode"></i> 2FA
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="timezone-tab" data-toggle="tab" href="#timezone" role="tab">
                        <i class="fas fa-globe-europe"></i> Region & API
                    </a>
                </li>
                
            </ul>
        </div>

        <div class="account-content card">
            <div class="tab-content" id="tabAccountContent">
                <!-- Security Tab -->
                <div class="tab-pane fade show active" id="security" role="tabpanel">
                    <div class="tab-header">
                        <i class="fas fa-shield-alt"></i>
                        <span>Change Password</span>
                    </div>
                    <form method="post" action="account">
                        <div class="form-group">
                            <label for="current-password">{{ lang['account.password.current'] }}</label>
                            <input type="password" class="form-control" name="current_password">
                        </div>
                        <div class="form-group">
                            <label for="new-password">{{ lang['account.password.new'] }}</label>
                            <input type="password" class="form-control" name="password">
                        </div>
                        <div class="form-group">
                            <label for="confirm-password">{{ lang['account.password.confirm'] }}</label>
                            <input type="password" class="form-control" name="confirm_password">
                        </div>
                        <button type="submit" class="btn btn-primary btn-full">{{ lang['account.password.button'] }}</button>
                    </form>
                </div>

                <!-- 2FA Tab -->
                <div class="tab-pane fade" id="twofa" role="tabpanel">
                    <div class="tab-header">
                        <i class="fas fa-qrcode"></i> Two-factor authentication
                    </div>
                    <form id="2fa-generate-form" method="post" action="/account/2fa/generate">
                        <p>Email-based option to add an extra layer of protection. You’ll need to enter a code sent to your email when signing in.</p>
                        <input type="hidden" name="enabled" value="1">
                        <button type="submit" class="btn btn-primary">Enable</button>
                    </form>
                </div>

                <!-- Region & API Tab -->
                <div class="tab-pane fade" id="timezone" role="tabpanel">
                    <div class="tab-header"><i class="fal fa-brackets-curly"></i> API Key</div>
                    <form action="/account/newapikey" method="post">
                        <div class="form-group">
                            <label>Api Key</label>
                            <input class="form-control" type="text" value="{{ masked_api_key }}" readonly>
                        </div>
                        <button type="submit" class="btn btn-primary">Generate New</button>
                    </form>

                    <div class="tab-header mt-5"><i class="fas fa-globe-europe"></i> Timezone</div>
                    <form action="account/timezone" method="post">
    <div class="mb-4">
        <label for="form-tz" class="form-label mb-2">Timezone</label>
        <select class="form-control" name="timezone" id="form-tz">
            {% for timezone in timezones %}
            <option {% if timezone["timezone"] == user['timezone'] %} selected {% endif %} value="{{ timezone["timezone"] }}">
                {{ timezone["label"] }}
            </option>
            {% endfor %}
        </select>
    </div>
    <button type="submit" class="btn btn-primary btn-100">Save</button>
</form>


                    
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Change Email Modal -->
<div class="modal fade" id="changeEmailModal" tabindex="-1" data-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <form id="changeEmailForm" method="post" action="">
                <div class="modal-header">
                    <i class="fas fa-at"></i>
                    <h5 class="modal-title">Change email</h5>
                    <button type="button" class="btn btn-line-icon" data-dismiss="modal">×</button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Current email</label>
                        <span class="form-control" disabled>{{ user['email'] }}</span>
                    </div>
                    <div class="form-group">
                        <label>New email</label>
                        <input type="email" class="form-control" name="ChangeEmailForm[email]">
                    </div>
                    <div class="form-group">
                        <label>Current password</label>
                        <input type="password" class="form-control" name="ChangeEmailForm[password]">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Change email</button>
                </div>
            </form>
        </div>
    </div>
</div>

            

		<!-- Notifications wrapper -->
		<div id="notify-wrapper" class="alert alert-success hidden" style="display: none;"></div>

		

