{% include 'header.twig' %}
<main>
                 <div class="container-fluid mt-1">
        
			 <div class="row">
				<div class="col-lg-12">
					 <div class="page overflow-hidden">
						<div class="page-body pb-4 pb-xl-6 mt-4">
						   <div class="card mb-2">
							  <div class="card-head d-flex align-items-center justify-content-between">
									<div class="card-head-title">
										<div class="row align-items-center">
											<div class="col-auto">
											  <div class="card-head-icon">
												<i class="ri-file-add-line"></i>
											  </div>
											</div>
											<div class="col">
											  <h4>Add Your Service to Our Panel</h4>
											</div>
										</div>
									</div>
							  </div>
							  <div class="card-body pt-5 pb-5">

                                <div class="row align-items-center">
                                  <div class="col-lg-7">
                                    	<div class="mobile-app-text">
                                          <h3 class="primary-color mb-3">Rules for Adding Service</h3>
											<div class="text-block__description">
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">1</div> 
													</div> 
													<div class="col">
														<p>Service must be cheaper than market prices, don't send us overpriced services. Save your and our time (For unical services and service providers special conditions apply)</p>
													</div>
												</div>
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">2</div> 
													</div> 
													<div class="col">
														<p>Services must be stable and meet the specified criteria in the description</p>
													</div>
												</div>												
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">3</div> 
													</div> 
													<div class="col">
														<p>You Must be have smm panel for connecting with API</p>
													</div>
												</div>	
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">4</div> 
													</div> 
													<div class="col">
														<p>You must give full support for service with chat on Telegram, Whatsapp any request with your service must be resolved within short time</p>
													</div>
												</div>
											</div>
                                        </div>
                                    	<div class="mobile-app-text mt-4">
                                          <h5 class="primary-color mb-3">For Service Adding Request Send message On Telegram like indicated below</h5>
											<div class="text-block__description">
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">1</div> 
													</div> 
													<div class="col">
														<p>Panel Link</p>
													</div>
												</div>
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">2</div> 
													</div> 
													<div class="col">
														<p>Service ID what you want to add</p>
													</div> 
												</div>												
												<div class="row align-items-center mb-2">
													<div class="col-auto"> 
														<div class="s-number">3</div> 
													</div> 
													<div class="col">
														<p>Created account details (login and password) on your panel with Test Balance</p>
													</div>
												</div>	
												<a href="https://telegram.me/onexpanelservice" target="_blank" class="btn btn-primary mt-4">Send Request</a>
											</div>
                                        </div>					
										
                                  </div>
                                  <div class="col-lg-5 text-center">
                                      <img src="https://storage.perfectcdn.com/a3vltc/t40t9n1z111hrh4q.png" class="adds-img">
                                  </div>
                                </div>
								
							  </div>
						   </div>
						</div>
					 </div>
				</div>
			 </div>
         </div>
      </main>

{% include 'footer.twig' %}