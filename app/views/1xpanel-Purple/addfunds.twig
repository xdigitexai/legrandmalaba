{% include 'footer.twig' %}

<script>
    var paymentMethods = {{ site["paymentMethodsJSON"] }};
    const addfundsRoute = "/addfunds";

    function addfundsInit() {
  var fields = $("#addfunds_fields");
  var selectedMethod = $("#payment_method").val();
  var instructions = paymentMethods[selectedMethod][0].instructions;

  $.ajax({
    url: addfundsRoute,
    data: { action: "getForm", selectedMethod: selectedMethod },
    type: "POST",
    dataType: "json",
    success: function (json) {
      if (json.success === true) {
        let methodInstruction = "";
        if (instructions.length > 0) {
          methodInstruction =
            '<div class="form-group">' +
              '<label class="control-label">Instructions</label>' +
              '<div class="panel-body border-solid border-rounded">' +
                instructions +
              "</div></div>";
        }
        $("#addfunds_fields").html(methodInstruction + json.content); // injects HTML
        extraFeeInit(selectedMethod);
      }
    }
  });
}

    function extraFeeInit(method) {
        var fee = parseFloat(paymentMethods[method][0].fee).toFixed(2);
        var fields = $("#fee_fields");
        if (fee > 0) {
            fields.html(
                '<div class="form-group">' +
                '<label class="control-label">Extra fee</label>' +
                '<input type="text" class="form-control" id="methodExtraFee" disabled value="0.00"/>' +
                '</div><div class="form-group">' +
                '<label class="control-label">Total Amount</label>' +
                '<input type="text" id="totalAmount" class="form-control" disabled value="0.00" />' +
                "</div>"
            );
        }
    }

    function preparePrice(t) {
        n = 2;
        var r = (t = $.trim(t.toString().replace(",", "."))).split(".");
        if (r[1] !== undefined) {
            r[1] = r[1].replace(/0+$/g, "");
            if (r[1].length > n) {
                n = r[1].length > 2 ? 2 : r[1].length;
            }
        }
        t = parseFloat(t).toFixed(n);
        if (t >= 1000) {
            t = t.toString().replace(/(\d)(?=(\d\d\d)+([^\d]|$))/g, "$1");
        }
        return parseFloat(t).toFixed(n);
    }

    $(document).ready(function () {
        // recalc fees on amount input
        $(document).on("keyup", "#paymentAmount", function () {
            var selectedMethod = $("#payment_method").val();
            var amount = parseFloat($(this).val());
            var feePercentage = parseFloat(paymentMethods[selectedMethod][0].fee);
            var feeInput = $("#methodExtraFee");
            var totalAmountInput = $("#totalAmount");
            var fee = amount * (feePercentage / 100);
            feeInput.val(preparePrice(fee));
            totalAmountInput.val(preparePrice(amount + fee));
        });

        // init on load
        addfundsInit();

        // change method -> reload form
        $("#payment_method").change(function () {
            addfundsInit();
        });

        // handle main form submit (step 1)
        $("#addfundsForm").submit(function (e) {
            e.preventDefault();
            var data = $(this).serialize();

            $.ajax({
                url: addfundsRoute,
                data: data,
                type: "POST",
                dataType: "json", // ✅
                success: function (json) {
                    if (json.success === true) {
                        $("#formSubmitResponseMessage").html(
                            '<div class="alert alert-success mt-2">' +
                            json.message +
                            "</div>"
                        );
                        $("#formSubmitResponseContent").html(json.content);
                    } else {
                        $("#formSubmitResponseMessage").html(
                            '<div class="alert alert-danger mt-2">' +
                            json.message +
                            "</div>"
                        );
                    }
                }
            });
        });
    });

    // handle nested forms (stepper Next buttons)
    document.addEventListener("submit", function(e) {
  if (e.target.closest("#addfunds_fields form")) {
    e.preventDefault();
    let form = e.target;

    $.ajax({
      url: addfundsRoute,
      method: "POST",
      data: new FormData(form),
      processData: false,
      contentType: false,
      dataType: "json",
      success: function(json) {
        if (json.success) {
          $("#addfunds_fields").html(json.content); // renders the HTML for the next step
        } else {
          alert(json.message || "Something went wrong.");
        }
      }
    });
  }
});
</script>

