<style>
/* Divider line */
.modal-divider {
  border: none;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
  margin: 0.75rem 0 1.25rem;
}

/* Custom Modal */
.custom-modal .modal-content {
  border-radius: 1.25rem;
  border: none;
  background: #fff;
  padding: 1.5rem 2rem;
  box-shadow: 0 6px 28px rgba(0, 0, 0, 0.15);
  position: relative;
  overflow: hidden;
}
.instructions {
  font-size: 0.9rem;
  color: #374151;
  background: #fafafa;
  border-radius: 14px;
  padding: 0.85rem;
  margin-bottom: 1rem;
  border: 1px solid #eee;
  box-shadow: inset 0 2px 5px rgba(0,0,0,0.03);
}
/* Header */
.modal-header {
  border: none;
}

.modal-title {
  font-weight: 700;
  font-size: 1.3rem;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #7e22ce;
}

.btn-close {
  background: none;
  border: none;
  font-size: 1.3rem;
  color: #444;
  transition: 0.3s;
}

.btn-close:hover {
  color: #7e22ce;
  transform: scale(1.2);
}

/* Stepper */
.stepper {
  display: flex;
  justify-content: center;
  gap: 0.6rem;
  margin-bottom: 1.5rem;
}

.step {
  background: #f3f4f6;
  color: #555;
  padding: 0.45rem 1rem;
  border-radius: 12px 30px 12px 30px; /* Unique futuristic shape */
  font-size: 0.85rem;
  border: 1px solid #e5e7eb;
  transition: 0.3s;
  box-shadow: 0 3px 6px rgba(0,0,0,0.05);
}

.step.active {
  background: #7e22ce;
  color: #fff;
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

.step.done {
  background: #a855f7;
  color: #fff;
}

/* Forms */
.form-group {
  margin-bottom: 1rem;
}



/* Info Boxes */
.info-box {
  background: #f9fafb;
  border-left: 4px solid #7e22ce;
  padding: 0.85rem 1rem;
  border-radius: 14px;
  font-size: 0.9rem;
  margin-bottom: 1rem;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

.info-box.warning {
  border-left-color: #f59e0b;
}

/* QR Code */
.qr-code {
  width: 160px;
  margin: 1rem auto;
  border-radius: 20px;
  box-shadow: 0 6px 14px rgba(0,0,0,0.12);
}

/* Instructions */
.instructions {
  font-size: 0.9rem;
  color: #374151;
  background: #fff;
  border-radius: 14px;
  padding: 0.85rem;
  margin-bottom: 1rem;
  border: 1px solid #eee;
  box-shadow: inset 0 2px 5px rgba(0,0,0,0.03);
}

/* Unique Futuristic Buttons */
.btn-submit {
  display: block;
  width: 100%;
  background: #7e22ce;
  color: #fff;
  border: none;
  padding: 1rem;
  border-radius: 18px 40px 18px 40px; /* asymmetrical futuristic shape */
  font-weight: 600;
  font-size: 1rem;
  transition: 0.3s;
  box-shadow: 0 6px 15px rgba(0,0,0,0.15);
}

.btn-submit:hover {
  background: #9333ea;
  transform: translateY(-2px);
  box-shadow: 0 8px 18px rgba(0,0,0,0.2);
}

/* Status box */
.status-box {
  font-size: 0.9rem;
  background: #fafafa;
  padding: 1rem;
  border-radius: 14px;
  margin: 1rem 0;
  border: 1px solid #eee;
  box-shadow: 0 3px 6px rgba(0,0,0,0.05);
}
</style>

    <script>
    document.getElementById("submitFinalPayment").addEventListener("click", function() {
        var form = document.getElementById("finalPaymentForm");
        var formData = new FormData(form);

        fetch("/addfunds", {
            method: "POST",
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            let msgBox = document.getElementById("finalPaymentMsg");
            if (data.success) {
                // Countdown for 10 minutes
                let timeLeft = 600; // 600 seconds = 10 minutes
                let countdown = setInterval(() => {
                    let mins = Math.floor(timeLeft / 60);
                    let secs = timeLeft % 60;
                    msgBox.innerHTML = `
                        <div class="alert alert-success">
                          ${data.message}<br>
                          Please wait <b>${mins}:${secs.toString().padStart(2,"0")}</b> for admin approval.
                        </div>`;
                    if (timeLeft <= 0) {
                        clearInterval(countdown);
                        msgBox.innerHTML = `<div class="alert alert-info">⏳ Still pending... please refresh to check status.</div>`;
                    }
                    timeLeft--;
                }, 1000);
                form.reset();
            } else {
                msgBox.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
            }
        })
        .catch(() => {
            document.getElementById("finalPaymentMsg").innerHTML = `<div class="alert alert-danger">Request failed.</div>`;
        });
    });
    </script>
