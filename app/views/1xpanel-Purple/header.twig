<style>
/* --- Container --- */
.nav-item.currencyItem.toggle-item {
  position: relative; /* anchor for the dropdown */
  display: inline-block;
}

/* --- Bell button --- */
#notifBtn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px;
  background: transparent;
  border: 0;
  cursor: pointer;
  border-radius: 8px;
  color: #e7e9ff;
  font-size: 18px;
  position: relative; /* so badge can be positioned relative to button */
}

/* hover look */
#notifBtn:hover { background: rgba(255,255,255,0.04); }

/* --- notification count badge --- */
#notification-count {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  font-size: 11px;
  line-height: 18px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #e53935;
  border-radius: 999px;
  box-shadow: 0 2px 6px rgba(0,0,0,.32);
  pointer-events: none;
  font-weight: 600;
}

/* --- dropdown body --- */
#notifications-dropdown {
  position: absolute;
  top: calc(100% + 12px); /* <-- distance under the button */
  right: 0;
  width: 320px;
  max-height: 420px;
  overflow-y: auto;
  background: #0f1222;
  border: 1px solid #252942;
  border-radius: 10px;
  box-shadow: 0 12px 28px rgba(0,0,0,.32);
  padding: 8px;
  z-index: 2500;

  /* Hidden state (keeps element in flow so positioning works) */
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
  transition: opacity .18s ease, transform .18s ease;
}

/* visible */
#notifications-dropdown.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

/* --- notification item --- */
.tn-item {
  padding: 8px 10px;
  border-bottom: 1px solid rgba(255,255,255,0.03);
  color: #dfe3ff;
}
.tn-item:last-child { border-bottom: none; }

.tn-date { font-size: 11px; color: #9aa0b4; margin-bottom: 4px; }
.tn-title { font-size: 13px; font-weight: 700; margin-bottom: 4px; color: #fff; }
.tn-text { font-size: 12px; color: #cfd3f4; line-height: 1.35; }

/* small button inside item */
.tn-btn a {
  display: inline-block;
  margin-top: 6px;
  font-size: 12px;
  padding: 6px 8px;
  border-radius: 6px;
  background: #7750f6;
  color: #fff;
  text-decoration: none;
}

/* Fix currency dropdown */
.balance-dropdown__container.dropdown-menu {
  min-width: 200px !important;   
  width: auto !important;        
  max-width: 90vw !important;    
  left: 50% !important;          /* start centering */
