<script>
$(document).ready(function () {
    renderCart();

    $('#add-to-cart').on('click', function () {
        const extraInputs = [
            "field-orderform-fields-answer_number",
            "field-orderform-fields-comment",
            "field-orderform-fields-comment_username",
            "field-orderform-fields-dripfeed",
            "field-orderform-fields-media_url",
            "field-orderform-fields-mention_usernames",
            "field-orderform-fields-hashtag",
            "field-orderform-fields-hashtags",
            "field-orderform-fields-keywords",
            "field-orderform-fields-min",
            "field-orderform-fields-old_posts",
            "field-orderform-fields-posts",
            "field-orderform-fields-user_name",
            "field-orderform-fields-username",
            "field-orderform-fields-usernames",
            "field-orderform-fields-usernames_custom"
        ];

        const hasVisibleExtraInput = extraInputs.some(id => {
            const el = document.getElementById(id);
            return el && el.offsetParent !== null;
        });

        if (hasVisibleExtraInput) {
            showToast("You cannot add this product to your cart.");
            return;
        }

        const linkInput = document.getElementById('field-orderform-fields-link');
        const miktarInput = document.getElementById('field-orderform-fields-quantity');
        const fiyatInput = document.getElementById('charge');
        const serviceIdInput = document.getElementById('orderform-service');

        if (!linkInput || !miktarInput || !fiyatInput || !serviceIdInput) {
            showToast("Please fill in the required fields.");
            return;
        }

        const link = linkInput.value.trim();
        const miktar = miktarInput.value.trim();
        const fiyat = fiyatInput.value.trim();
        const servisId = serviceIdInput.value.trim();

        if (!link || !miktar || !fiyat || !servisId) {
            showToast("Please fill in the required fields.");
            return;
        }

        const servis = window.modules?.siteOrder?.services?.[servisId]?.name || "Unknown Service";

        let cart = JSON.parse(localStorage.getItem('orderCart')) || [];

        const item = {
            id: Date.now(),
            link,
            miktar,
            fiyat,
            servis,
            servisId
        };

        cart.push(item);
        localStorage.setItem('orderCart', JSON.stringify(cart));

        showToast("Added to your cart.", true);
        renderCart();
    });
});

function renderCart() {
    const cart = JSON.parse(localStorage.getItem('orderCart')) || [];
    const $cartItems = $('#sepetListe');
    const $cartSummary = $('#sepetAlt');

    $cartItems.html('');
    $cartSummary.html('');

    const totalItems = cart.length;
    $('#sepetsayi').text(`${totalItems}`);

    if (totalItems === 0) {
        $('#sepetsayi').css('display', 'none');
        $cartItems.html('<p>There are no orders in your cart.</p>');
        return;
    }

    cart.forEach(item => {
        $cartItems.append(`
            <div class="sepetbox">
                <div class="sepettop">
                    <div class="sepetname">
                        <div class="sepetservis"><strong>Services :</strong>${item.servis}</div>
                    </div>
                    <div class="sepetdetails">
                        <div class="sptalt"><strong>Link :</strong> <span>${item.link}</span></div>
                        <div class="sptalt"><strong>Quantity :</strong> <span>${item.miktar}</span></div>
                    </div>
                </div>
                <div class="sepetbottom">
                    <div class="sepetfiyat">${item.fiyat}</div>
                    <button type="button" onclick="removeFromCart(${item.id})"><i class="ri-close-circle-fill"></i></button>
                </div>
            </div>
        `);
    });

    $cartSummary.html(`
        <div class="sepetprice">
            <div class="sepetcharge">
                <strong>Charge:</strong> <span id="sepetallprice">$ 0.00</span>
            </div>
            <button type="submit" class="btn btn-primary" id="sepetbuy">Buy now</button>
        </div>
    `);

    $('#sepetsayi').css('display', 'block');

    setTimeout(updateTotalFromVisiblePrices, 10);
}

function updateTotalFromVisiblePrices() {
    let toplam = 0;
    $('.sepetfiyat').each(function () {
        const fiyatText = $(this).text().replace(",", ".").replace("₺", "").replace("$", "").trim();
        const fiyatSayi = parseFloat(fiyatText);
        if (!isNaN(fiyatSayi)) {
            toplam += fiyatSayi;
        }
    });

    $('#sepetallprice').text(`$ ${toplam.toFixed(2)}`);
}

function removeFromCart(id) {
    let cart = JSON.parse(localStorage.getItem('orderCart')) || [];
    cart = cart.filter(item => item.id !== id);
    localStorage.setItem('orderCart', JSON.stringify(cart));
    renderCart();
}

function showToast(message, success = false) {
    const toastEl = $('.bs-toast');
    const toastText = $('.toast-text');

    toastText.html(message);
    toastEl.css("display", "block");

    if (success) {
        toastEl.removeClass('toast-error').addClass('toast-success');
    } else {
        toastEl.removeClass('toast-success').addClass('toast-error');
    }

    setTimeout(() => {
        toastEl.css("display", "none");
    }, 3000);
}
$(document).on('click', '#sepetbuy', function (e) {
    e.preventDefault();

    const cart = JSON.parse(localStorage.getItem('orderCart')) || [];

    if (cart.length === 0) {
        showToast("Your cart is empty.");
        return;
    }

    const crsft = window.modules?.layouts?.csrftoken || '';

    if (!crsft) {
        showToast("CSRF token missing.");
        return;
    }

    const ordersText = cart.map(item => {
        return `${item.servisId} | ${item.link} | ${item.miktar}`;
    }).join('\n');

    const $form = $(`
        <form method="post" action="/massorder">
            <input type="hidden" name="_csrf" value="${crsft}">
            <textarea name="MassOrderForm[orders]" rows="15" style="display:none;">${ordersText}</textarea>
        </form>
    `);

    $('body').append($form);
    $form.submit();
});

$(document).ready(function () {
    if ($(".mass-success").length > 0) {
        localStorage.removeItem("orderCart");
        renderCart();
    }
});

</script>

