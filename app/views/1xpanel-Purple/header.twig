    <div class="profile-box-btn">
        <div class="switcher" data-active="light">
            <button class="switcher-item light-btn" onclick="changeTheme('light')" aria-label="Light">
                <i class="fas fa-sun"></i>
                <span>Light</span>
            </button>
            <button class="switcher-item dark-btn active" onclick="changeTheme('dark')" aria-label="Dark">
                <i class="fas fa-moon"></i>
                <span>Dark</span>
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const logo = document.getElementById("site-logo");

    const logos = [
        "{{ site['logo_light'] | default(site['logo']) }}",
        "{{ site['logo_dark'] | default(site['logo']) }}"
    ];

    // Preload logos
    logos.forEach(src => { const img = new Image(); img.src = src; });

    function updateLogo(mode) {
        if(mode === "dark") logo.src = logos[1];
        else if(mode === "light") logo.src = logos[0];
        else { // auto
            const darkMode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            logo.src = darkMode ? logos[1] : logos[0];
        }
    }

    function colorApp() {
        let getmode = localStorage.getItem("themeMode") || "dark";

        if(getmode === "auto") {
            let isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.setAttribute("class", isDarkMode ? "dark" : "light");
        } else {
            document.documentElement.setAttribute("class", getmode);
        }

        document.querySelectorAll(".switcher-item").forEach(btn => btn.classList.remove("active"));
        if(getmode === "light") document.querySelector(".light-btn").classList.add("active");
        else if(getmode === "dark") document.querySelector(".dark-btn").classList.add("active");
        else document.querySelector(".auto-btn").classList.add("active");

        // <-- Update logo on theme change
        updateLogo(getmode);
    }

    window.changeTheme = function(mode) {
        localStorage.setItem("themeMode", mode);
        colorApp();
    }

    // System theme change
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if(localStorage.getItem("themeMode") === "auto") colorApp();
    });

    // Initial
    colorApp();
});
</script>
