<script>
document.addEventListener('DOMContentLoaded', function () {
  const btn = document.getElementById('notifBtn');
  const dropdown = document.getElementById('notifications-dropdown');

  if (!btn || !dropdown) return; // safety

  function openDropdown() {
    dropdown.classList.add('show');
    btn.setAttribute('aria-expanded', 'true');
  }
  function closeDropdown() {
    dropdown.classList.remove('show');
    btn.setAttribute('aria-expanded', 'false');
  }
  function toggleDropdown() {
    if (dropdown.classList.contains('show')) closeDropdown();
    else openDropdown();
  }

  btn.addEventListener('click', function (ev) {
    ev.stopPropagation(); // don't let document click handler close it immediately
    toggleDropdown();
  });

  // Keep clicks inside the dropdown from closing it
  dropdown.addEventListener('click', function (ev) {
    ev.stopPropagation();
  });

  // Click outside closes the dropdown
  document.addEventListener('click', function (ev) {
    if (!btn.contains(ev.target) && !dropdown.contains(ev.target)) {
      closeDropdown();
    }
  });

  // Esc closes
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') closeDropdown();
  });
});
</script>

			
