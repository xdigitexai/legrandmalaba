</style>

<div class="nav-item currencyItem toggle-item">
  <button id="notifBtn" aria-expanded="false" aria-controls="notifications-dropdown" aria-haspopup="true" type="button">
    <!-- Inline bell SVG -->
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11c0-3.07-1.64-5.64-4.5-6.32V4a1.5 1.5 0 10-3 0v.68C7.64 5.36 6 7.92 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h11z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M13.73 21a2 2 0 01-3.46 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

    <!-- Dynamic notification count -->
    <span id="notification-count" aria-hidden="true">{{ news|length }}</span>
  </button>

  <div id="notifications-dropdown" role="menu" aria-labelledby="notifBtn">
    {% for new in news %}
    <div class="tn-item" role="menuitem">
        <div class="tn-date">
            <i class="fad fa-calendar-alt"></i> {{ new.news_date }}
        </div>
        <div class="tn-title">{{ new.news_title }}</div>
        <div class="tn-text">
            Service ID : {{ new.service_id }} , {{ new.news_content }}
            <span style="color:#ff6b6b">{{ new.highlight }}</span>
        </div>
        <div class="tn-btn">
