<script>
    const htmlcontent = document.documentElement;

    function colorApp() {
        let getmode = localStorage.getItem("themeMode") || "dark";

        if (getmode === "auto") {
            let isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
            htmlcontent.setAttribute("class", isDarkMode ? "dark" : "light");
        } else {
            htmlcontent.setAttribute("class", getmode);
        }

        // Reset active state
        document.querySelectorAll(".switcher-item").forEach(btn => btn.classList.remove("active"));

        if (getmode === "light") {
            document.querySelector(".light-btn").classList.add("active");
        } else if (getmode === "dark") {
            document.querySelector(".dark-btn").classList.add("active");
        } else {
            document.querySelector(".auto-btn").classList.add("active");
        }
    }

    function changeTheme(mode) {
        localStorage.setItem("themeMode", mode);
        colorApp();
    }

    // Update if system theme changes and mode is auto
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
        if (localStorage.getItem("themeMode") === "auto") {
            colorApp();
        }
    });

    // Initialize on load
    colorApp();
</script>

