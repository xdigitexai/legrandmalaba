		<script>
function updateTextarea() {
  let combinedText = '';

  $('.fast-mass').each(function() {
    const massId = $(this).find('input[name="mass-id"]').val() || '';
    const massLink = $(this).find('input[name="mass-link"]').val() || '';
    const massQuantity = $(this).find('input[name="mass-quantity"]').val() || '';

    if (massId || massLink || massQuantity) {
      combinedText += `${massId} | ${massLink} | ${massQuantity}\n`;
    }
  });

  $('#links').val(combinedText.trim());
  toggleAddMoreButton();
}

function toggleAddMoreButton() {
  if ($('.fast-mass').length === 1) {
    $('.fast-mass').first().find('.add-more').show();
  }
}

function bindInputs() {
  $('.fast-mass input').off('input').on('input', updateTextarea);
}

function bindAddMore() {
  $('.add-more').off('click').on('click', function() {
    const currentFastMass = $(this).closest('.fast-mass');
    const cloned = currentFastMass.clone();
    cloned.find('input').val('');
    currentFastMass.find('.add-more').hide();
    if (cloned.find('.remove-more').length === 0) {
      cloned.append('<button type="button" class="remove-more">Remove</button>');
    }
    cloned.find('.remove-more').removeClass('hidden');
    currentFastMass.after(cloned);
    bindInputs();
    bindAddMore();
    bindRemoveMore();
    updateTextarea();
  });
}

function bindRemoveMore() {
  $('.remove-more').off('click').on('click', function() {
    const removedDiv = $(this).closest('.fast-mass');
    removedDiv.remove(); 
    updateTextarea();
    if ($('.fast-mass').length === 1) {
      $('.fast-mass').first().find('.add-more').show();
    }
  });
}

$(document).ready(function() {
  updateTextarea();
  bindInputs();
  bindAddMore();
  bindRemoveMore();
  toggleAddMoreButton();
});  
