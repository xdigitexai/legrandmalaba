<script>
document.addEventListener("DOMContentLoaded", function () {
    // Function to open modal
    window.modalOpen = function(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.style.display = "flex";
            document.body.style.overflow = "hidden"; // prevent background scroll
        }
    }

    // Close modal buttons
    const closeButtons = document.querySelectorAll(".modal-wrapper .m-close");
    closeButtons.forEach(btn => {
        btn.addEventListener("click", function() {
            const modal = this.closest(".modal-wrapper");
            modal.style.display = "none";
            document.body.style.overflow = "auto"; // restore scroll
        });
    });

    // Close modal when clicking outside the modal box
    const modals = document.querySelectorAll(".modal-wrapper");
    modals.forEach(modal => {
        modal.addEventListener("click", function(e) {
            if(e.target === this){
                modal.style.display = "none";
                document.body.style.overflow = "auto";
            }
        });
    });
});
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const newOrderCats = document.getElementById('new-order-cats');

    if (newOrderCats) {
      const orderFormCats = document.getElementById('neworder_category');
      const originalOptions = Array.from(orderFormCats.options); // Backup original options

      const categoryButtons = document.querySelectorAll('.nwo-cat-btn');
      
      categoryButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selectedCategory = btn.getAttribute('data-change-cat'); // Get clicked category value
          
          // Reset active class for all buttons
          categoryButtons.forEach(button => button.classList.remove('active'));
          btn.classList.add('active'); // Highlight active button

          if (selectedCategory === "") {
            // Reset dropdown to show all options
            orderFormCats.innerHTML = originalOptions.map(opt => opt.outerHTML).join('');
          } else {
            // Filter options based on category
            const filteredOptions = originalOptions.filter(option =>
              option.textContent.toLowerCase().includes(selectedCategory.toLowerCase())
            );

            // Update dropdown
            if (filteredOptions.length > 0) {
              orderFormCats.innerHTML = filteredOptions.map(opt => opt.outerHTML).join('');
            } else {
              orderFormCats.innerHTML = '<option value="">No options available</option>';
            }
          }

          // Trigger change event for additional logic
          const event = new Event('change');
          orderFormCats.dispatchEvent(event);
        });
      });
    }
  });
</script>
