              <script>
document.addEventListener("DOMContentLoaded", function () {
    const navItems = document.querySelectorAll(".cstmnav li a");
    const catButtons = document.querySelectorAll(".nwo-cat-btn");

    const platformClassMap = {
        'btn-instagram': 'Instagram',
        'btn-facebook': 'Facebook',
        'btn-youtube': 'Youtube',
        'btn-telegram': 'Telegram',
        'btn-tiktok': 'TikTok',
        'btn-twitter': 'Twitter',
        'btn-spotify': 'Spotify',
        'btn-twitch': 'Twitch',
        'btn-reddit': 'Reddit',
        'btn-snapchat': 'Snapchat',
        'btn-linkedin': 'LinkedIn',
        'btn-threads': 'Threads'
    };

    navItems.forEach(nav => {
        nav.addEventListener("click", function(e) {
            e.preventDefault(); // prevent external redirect

            // Remove active class from nav
            navItems.forEach(n => n.classList.remove("active"));
            this.classList.add("active");

            // Detect category
            const platform = Object.keys(platformClassMap).find(cls => this.classList.contains(cls));
            const categoryName = platformClassMap[platform];

            // Find and "click" the corresponding category button
            catButtons.forEach(btn => {
                if (btn.getAttribute("data-change-cat") === categoryName) {
                    btn.click(); // trigger the actual click
                }
            });
        });
    });
});
</script>
