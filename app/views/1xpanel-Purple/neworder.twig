						<script>
document.addEventListener("DOMContentLoaded", function() {
    const filterBtn = document.getElementById("neworder-filter-btn");
    const filterPanel = document.querySelector(".neworder-filter");
    const catButtons = document.querySelectorAll(".nwo-cat-btn");
    const input = document.getElementById("template-input");

    // Ensure the filter panel is hidden initially
    filterPanel.style.display = "none";
    filterPanel.style.opacity = "0";
    filterPanel.style.transition = "opacity 0.3s ease";

    // Toggle filter panel
    filterBtn.addEventListener("click", () => {
        if (filterPanel.style.display === "none") {
            filterPanel.style.display = "block";
            setTimeout(() => { filterPanel.style.opacity = "1"; }, 10);
        } else {
            filterPanel.style.opacity = "0";
            setTimeout(() => { filterPanel.style.display = "none"; }, 300);
        }
    });

    // Category buttons click
    catButtons.forEach(btn => {
        btn.addEventListener("click", () => {
            // Remove active class from all
            catButtons.forEach(b => b.classList.remove("active"));
            // Add active class to clicked button
            btn.classList.add("active");

            // Put selected category into the input
            const selectedCat = btn.getAttribute("data-change-cat");
            input.value = selectedCat;

            // Optional: here you can filter services list
            console.log("Selected category:", selectedCat);
        });
    });

    // Search icon click focuses input
    const searchBtn = document.querySelector(".search-dropdown button");
    if (searchBtn) {
        searchBtn.addEventListener("click", () => input.focus());
    }
});
</script>

