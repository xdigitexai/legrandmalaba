<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Payment Processing</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #0b1220;
      --accent: #06b6d4;
      --muted: #9ca3af;
      --glass: rgba(255, 255, 255, 0.04);
    }
    * { box-sizing: border-box; }
    body {
      font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background: linear-gradient(180deg, #07112a 0%, #021026 100%);
      height: 100vh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #e6eef8;
    }
    .btn {
      background: var(--accent);
      color: #042029;
      padding: 10px 14px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-weight: 600;
    }

    /* overlay & modal */
    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }
    .modal {
      width: min(680px, 95%);
      background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));
      border-radius: 16px;
      padding: 22px;
      box-shadow: 0 10px 30px rgba(2, 6, 23, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.03);
    }
    .modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
    }
    .title {
      font-size: 1.25rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .subtitle {
      color: var(--muted);
      font-size: 0.95rem;
    }
    .close {
      background: transparent;
      border: 0;
      color: var(--muted);
      font-size: 18px;
      cursor: pointer;
    }

    .rows { margin-top: 14px; display: grid; gap: 12px; }
    .row {
      background: var(--glass);
      padding: 12px 14px;
      border-radius: 12px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .icon { font-size: 20px; margin-top: 2px; }
    .row strong { display: block; font-weight: 700; }
    .muted { color: var(--muted); }

    .checking {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 10px;
    }
    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 4px solid rgba(255, 255, 255, 0.06);
      border-left-color: var(--accent);
      animation: spin 1s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .footer {
      margin-top: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .note { color: var(--muted); font-size: 0.92rem; }

    /* responsive */
    @media (max-width:420px) {
      .modal { padding: 16px; }
      .title { font-size: 1.05rem; }
    }
  </style>
</head>
<body>

  <!-- Overlay & modal -->
  <div class="overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle" aria-describedby="modalDesc">
    <div class="modal" id="modal">
      <div class="modal-header">
        <div>
          <div class="title" id="modalTitle">Pending for Review</div>
          <div class="subtitle" id="modalDesc">🕓 Please wait while admin verifies your payment. This may take up to <strong>1 hour</strong>.</div>
        </div>
        <button class="close" id="closeBtn" aria-label="Close modal">✕</button>
      </div>

      <div class="rows">
        <div class="row">
          <div class="icon">🔄</div>
          <div>
            <strong>Your payment request has been submitted and is now pending admin verification.</strong>
            <div class="muted">🔁 We'll notify you automatically once it's approved.</div>
          </div>
        </div>

        <div class="row">
          <div class="icon">💬</div>
          <div>
            <strong>Please wait while our admin team reviews your submission.</strong>
            <div class="muted">Once approved, your balance will be updated automatically.</div>
          </div>
        </div>

        <div class="row">
          <div class="icon">⏳</div>
          <div>
            <strong>Estimated review time:</strong>
            <div class="muted">0–1 hour depending on admin availability.</div>
          </div>
        </div>

        <div class="row" aria-live="polite">
          <div class="icon">🕵️‍♂️</div>
          <div>
            <strong id="statusText">Checking status in 5 seconds...</strong>
            <div class="muted" id="lastChecked"></div>
          </div>
        </div>

        <div class="checking">
          <div class="spinner" id="spinner" aria-hidden="true"></div>
          <div class="muted">Waiting for admin verification — automatic checks every 5 seconds.</div>
        </div>
      </div>

      <div class="footer">
        <div class="note">Tip: Keep this page open. You'll be notified when the status changes.</div>
        <div><button class="btn" id="manualCheck">Check now</button></div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const closeBtn = document.getElementById('closeBtn');
      const overlay = document.querySelector('.overlay');
      const statusText = document.getElementById('statusText');
      const lastChecked = document.getElementById('lastChecked');
      const spinner = document.getElementById('spinner');
      const manual = document.getElementById('manualCheck');

      let countdown = 5;
      let intervalId = null;

      function formatTime(d){
        const hh = String(d.getHours()).padStart(2,'0');
        const mm = String(d.getMinutes()).padStart(2,'0');
        const ss = String(d.getSeconds()).padStart(2,'0');
        return hh+':'+mm+':'+ss;
      }

      function doCheck(){
        spinner.style.opacity = '1';
        statusText.textContent = 'Checking status...';
        setTimeout(()=>{
          const now = new Date();
          lastChecked.textContent = 'Last checked at ' + formatTime(now);

          // Simulated outcome: 98% remain pending, 2% approved
          if(Math.random() < 0.02) {
            statusText.textContent = '✅ Payment approved — balance will be updated shortly.';
            spinner.style.opacity = '0';
            clearInterval(intervalId);
            setTimeout(()=> overlay.style.display = 'none', 1800);
            return;
          }

          countdown = 5;
          updateCountdownText();
        }, 1000);
      }

      function updateCountdownText(){
        statusText.textContent = 'Checking status in ' + countdown + ' second' + (countdown===1?'':'s') + '...';
      }

      function startTimer(){
        updateCountdownText();
        intervalId = setInterval(()=>{
          countdown--;
          if(countdown <= 0){
            doCheck();
          } else {
            updateCountdownText();
          }
        }, 1000);
      }

      manual.addEventListener('click', ()=>{ doCheck(); });
      closeBtn.addEventListener('click', ()=>{ overlay.style.display = 'none'; clearInterval(intervalId); });
      document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape'){ overlay.style.display = 'none'; clearInterval(intervalId); } });

      startTimer();
    })();
  </script>
  <script>
  (function(){
    // ✅ If not redirected from /addfunds → show 404
    if (!document.referrer.includes("/addfunds")) {
      document.body.innerHTML = `
        <div style="text-align:center; padding:50px; font-family:sans-serif; color:#e6eef8;">
          <h1 style="font-size:3rem;">404</h1>
          <p style="font-size:1.2rem;">Page not found</p>
          <a href="/" style="color:#06b6d4; text-decoration:none;">Go back home</a>
        </div>
      `;
      return;
    }

    // ✅ Redirect to /neworder after 20 seconds
    setTimeout(()=>{
      window.location.href = "/neworder";
    }, 5000);

    const closeBtn = document.getElementById('closeBtn');
    const overlay = document.querySelector('.overlay');
    const statusText = document.getElementById('statusText');
    const lastChecked = document.getElementById('lastChecked');
    const spinner = document.getElementById('spinner');
    const manual = document.getElementById('manualCheck');

    let countdown = 5;
    let intervalId = null;

    function formatTime(d){
      const hh = String(d.getHours()).padStart(2,'0');
      const mm = String(d.getMinutes()).padStart(2,'0');
      const ss = String(d.getSeconds()).padStart(2,'0');
      return hh+':'+mm+':'+ss;
    }

    function doCheck(){
      spinner.style.opacity = '1';
      statusText.textContent = 'Checking status...';
      setTimeout(()=>{
        const now = new Date();
        lastChecked.textContent = 'Last checked at ' + formatTime(now);

        // Simulated outcome: 98% remain pending, 2% approved
        if(Math.random() < 0.02) {
          statusText.textContent = '✅ Payment approved — balance will be updated shortly.';
          spinner.style.opacity = '0';
          clearInterval(intervalId);
          setTimeout(()=> overlay.style.display = 'none', 1800);
          return;
        }

        countdown = 5;
        updateCountdownText();
      }, 1000);
    }

    function updateCountdownText(){
      statusText.textContent = 'Checking status in ' + countdown + ' second' + (countdown===1?'':'s') + '...';
    }

    function startTimer(){
      updateCountdownText();
      intervalId = setInterval(()=>{
        countdown--;
        if(countdown <= 0){
          doCheck();
        } else {
          updateCountdownText();
        }
      }, 1000);
    }

    manual.addEventListener('click', ()=>{ doCheck(); });
    closeBtn.addEventListener('click', ()=>{ overlay.style.display = 'none'; clearInterval(intervalId); });
    document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape'){ overlay.style.display = 'none'; clearInterval(intervalId); } });

    startTimer();
  })();
</script>

</body>
</html>
