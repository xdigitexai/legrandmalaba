<body>
<div class="container"> 
  <div class="section">    
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Select all main refund container blocks
    const refundSections = document.querySelectorAll('div.col-lg-12');

    // Keep track of seen inner content
    const seenContent = new Set();

    refundSections.forEach(section => {
      const htmlContent = section.innerHTML.trim();

      if (seenContent.has(htmlContent)) {
        // Remove duplicate section
        section.remove();
      } else {
        seenContent.add(htmlContent);
      }
    });
  });
</script>

    <div class="col-lg-12">
      <div class="row align-items-center justify-content-between mb-4">
        <div class="col-md-auto col-12">

       
          </div>
        </div>
      </div>
	       
      <!-- Refunds Card Layout -->
      <div class="">
        <div class="">
          <div class="">
            <tbody>
              {% if refunds is not empty %}
                {% for refund in refunds %}
                  <tr>
                    <td>
                      <div class="order-item">
                        <div class="order-item-top">
                          <div class="oit-first">
                            <div class="order-id" onclick="copy('{{ refund.order_id }}', 'Refund ID copied.', 'fa-copy')" style="cursor:pointer" data-toggle="tooltip">
                              Refund #{{ refund.order_id }} <span class="far fa-copy order-link primary-color pl-1"></span>
                            </div>
                            <div class="order-title">
                              <span>
                                <span style="background:var(--main-color);color:var(--text-white);padding: 0 5px; border-radius: 3px;font-weight:700">
                                  Refunded ₱{{ refund.refund_amount|number_format(2, '.', ',') }}
                                </span>
                              </span>
                            </div>
                          </div>
                          <div class="oit-last">
                            <div class="order-status c-pointer">
                              <span class="os-widget {{ refund.order_status }}">
                                {{ refund.order_status|capitalize }}
                              </span>
                            </div>
                          </div>
                        </div>

                        <div class="order-item-bottom">
                          <div class="oib-first">
                            <span class="item date">
                              <i class="far fa-calendar-week primary-color"></i>
                              <strong>{{ refund.date }}</strong>
                            </span>
                            <span class="item flex-item">
                              <span class="primary-color">
                                <i class="fas fa-receipt"></i>
                                <span>Order ID:</span>
                              </span>
                              <a href="/orders?search={{ refund.order_id }}"><strong>{{ refund.order_id }}</strong></a>
                            </span>
                          </div>
                          <div class="oib-last">
                            <div class="btn-report c-pointer mt-3 mt-lg-0" data-toggle="tooltip" data-placement="top" title="Support">
                              <a href="/tickets" class="btn btn-success" style="background-color: #22c8fe65;border-color:var(--main-color)">
                                <i class="fas fa-user-headset"></i>
                              </a>
                            </div>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              
              {% endif %}
            </tbody>
          </div>
        </div>
      </div>

      <!-- Pagination -->
      {% if pagination["count"] > 1 %}
        <ul class="pagination">
          {% if pagination["current"] != 1 %}
            <li>
              <a class="btn btn-actions" href="refunds/{{ status }}/{{ pagination["previous"] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Previous">
                <span aria-hidden="true">«</span>
              </a>
            </li>
          {% endif %}

          {% set r, l = 3, 3 %}
          {% if pagination['current'] == 1 %}{% set r = 7 %}{% endif %}
          {% if pagination['current'] == 2 %}{% set r = 5 %}{% endif %}
          {% if pagination['current'] >= pagination['count'] %}{% set l = 5 %}{% endif %}

          {% for page in 1..pagination["count"] %}
            {% if page >= (pagination['current']-l) and page <= (pagination['current']+r) %}
              <li{% if page == pagination['current'] %} class="active" {%endif%}>
                <a class="btn btn-actions" href="refunds/{{ status }}/{{ page }}{% if search %}?search={{ search }}{% endif %}">{{ page }}</a>
              </li>
            {% endif %}
          {% endfor %}

          {% if pagination['current'] < pagination['count'] %}
            <li>
              <a class="btn btn-actions" href="refunds/{{ status }}/{{ pagination['next'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Next">
                <span aria-hidden="true">»</span>
              </a>
            </li>
          {% endif %}
        </ul>
      {% endif %}

    </div>
  </div>
</div>

<div class="divider-top"></div>
<div class="divider-bottom"></div>

{% include 'footer.twig' %}