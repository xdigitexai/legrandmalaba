{% include 'header.twig' %}
            <style>#header, footer {display: none}</style>
<div class="signup-area">
  <div class="home-fade">
      <div>
         <div class="hf-glow"></div>
      </div>
  </div>  
  <div class="signup-header">
		<div class="signup-logo">
           <a href="/">
															<img src="https://storage.perfectcdn.com/2vot6g/3h5nu556akg9mob9.png" alt="TheMainSmm.com" title="TheMainSmm.com" height="45">
							           </a>
   	    </div>
    	<a href="/" class="btn btn-primary">
    	  <i class="ri-arrow-left-line"></i> 
          <span>
            	Back to Home
          </span>
    	</a>
  </div>
  
<div class="container">
	  <div class="row">
		  <div class="col-lg-6 offset-lg-3">
              <div class="signup-badge">
                  <div class="icon"><i class="ri-lock-password-line"></i></div>
                  <div class="text">
                   <span>Set password</span>
                     <small>Please enter your information correctly to set your password.</small>
                  </div>
              </div>
			  <div class="signup-content">
        <form method="post" action="">

          <div class="form-group">
            <label for="email" class="control-label">Username</label>
            <input type="text" class="form-control" value="{{ user['username'] }}" placeholder="{{ user['username'] }}" readonly>
          </div>
<div class="form-group">
        
<label class="control-label" for="orderpanelform-password">Password</label><input type="password" class="form-control" name="password" placeholder="New Password" required>
    </div>
    		  <div class="form-group">
        
<label class="control-label" for="orderpanelform-password">Confirm Password</label><input type="password" class="form-control" name="password_again" placeholder="Password" required>
    </div>


   

            <button type="submit" class="btn btn-primary w-100">Change</button>
        </form>
      </div>
    </div>
  </div></div>

    </div></div></div>
</div></div>
</div>
{% include 'footer.twig' %}
