<style>
    .m-b-icon {

        width: 40px;
        height: 40px;
        background-color: #4eb3eb;
        border-radius: 8px;
        display: flex;
        margin-top: 5px;
        justify-content: center;
        align-items: center;
    }
    .m-b-i {
        font-size: 1.45rem;
    }
    .m-b-txt1 {

        color: black;
        font-size: 1.67rem;
        font-weight: 670;
    }
    .m-b-txt2 {
        margin: 5px;
        color: #3c4148;
        font-size: 1.25rem;
    }
    .m-b-c1 {
        font-size: 2.89rem;
    }
    .l-whatsappjoin {
        width: 60%;
        height: 50px;
        border-radius: 30px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding-left: 20px;
        gap: 9px;
        color: white;
        background: green;
        position: relative;
        cursor: pointer;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.212);
        font-weight: 650;
    }
    .signupBtn {
        width: 45%;
        height: 50px;
        border-radius: 30px;
        border: none;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        padding-left: 20px;
        gap: 9px;
        color: white;
        background: linear-gradient(to right,rgb(128, 128, 255),rgb(183, 128, 255));
        position: relative;
        cursor: pointer;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.212);
        font-weight: 550;
    }

    .arrow {
        position: absolute;
        right: 7.5px;
        background-color: rgb(255, 255, 255);
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    .signupBtn:hover .arrow {
        animation: slide-in-left 0.7s cubic-bezier(0.250, 0.460, 0.450, 0.940) both;
    }

    @keyframes slide-in-left {
        0% {
            transform: translateX(-10px);
            opacity: 0;
        }

        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    .line {
        width: 100%;
        background-color: #c9c9c9;
        height: 2px;
        margin: auto;
        margin-top: 8vh;
        box-shadow: rgba(0, 0, 0, 0.18) 0px 2px 4px;
    }
    .signuptext {

        display: flex;
        justify-content: center;
        align-items: center;
        margin-right: 5%;
    }

    .m-t-2 span {
        font-weight: 590;
    }
    .m-t-2 a {
        font-weight: 500;
    }

    .benefit-title:hover {
        background-color: red;
    }



    img {
        width: 100%;
        height: auto;
        margin: auto;
    }
    .l-text {
        margin-top: 30%;
        color: black;
        font-size: 2.67rem;
        font-weight: 900;
    }
    .l-2-text {
        color: #6b6b6b;
        margin-top: 2%;
        font-size: 1.27rem;


    }

</style>

