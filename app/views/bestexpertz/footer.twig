<script>
   var post_data = "actionType=notifications&apiKey=Press regenerate button in the settings to generate your api key.";
   var xhttp = new XMLHttpRequest();
   xhttp.onreadystatechange = function () {
     if (this.readyState == 4 && this.status == 200) {
       var response = JSON.parse(this.responseText);
       var c = new Date();
       var months = [
         "January",
         "February",
         "March",
         "April",
         "May",
         "June",
         "July",
         "August",
         "September",
         "October",
         "November",
         "December",
       ];
       var cc = c.getDate() + " " + months[c.getMonth()];
       var content = "";
       if (typeof response.data !== "undefined") {
         var d = response.data;
         if (d.length > 0) {
           for (a = 0; a < d.length; a++) {
             var f = d[a];
             console.log(f);
 
             var subject = "";
             if (typeof f.subject !== "undefined") {
               subject = f.subject;
             }
 
             var date = "";
             if (typeof f.date !== "undefined") {
               date = f.date;
             }
 
             var c = new Date(date);
             var months = [
               "January",
               "February",
               "March",
               "April",
               "May",
               "June",
               "July",
               "August",
               "September",
               "October",
               "November",
               "December",
             ];
             var date =
               c.getDate() + " " + months[c.getMonth()] + " " + c.getFullYear();
 
             var message = "";
             if (typeof f.message !== "undefined") {
               message = f.message;
             }
 
             var id = "";
             if (typeof f.id !== "undefined") {
               id = f.id;
             }
 
             if (message.length > 0) {
               content =
                 content +
                 ' <li class="singleNewsBlock"><div class="type-date"><p class="date">   ' +
                 date +
                 ' </p></div><br><div class="news-desc">' +
                 "<p><b>" +
                 subject +
                 "</b></p><p>" +
                 message +
                 "</p></div></li>";
             }
           }
         }
       }
 
       if (content.length == 0) {
         content =
           '<li><h4>Notification<span class="date">' +
           cc +
           "</span></h4><p>No Notification Found</p></li>";
       }
 
       document.getElementById("news_updates_div").innerHTML = content;
       //news_updates_div
     }
   };
   xhttp.open("POST", "api", true);
   xhttp.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
   xhttp.send(post_data);
 </script>
