    if ($currenciesList.hasClass("active")) {
        $currenciesList.removeClass("active");
    } else {
        $currenciesList.addClass("active");
    }
});

$(".header-detail-button.active-account-detail").click(function(){
    var $accountDetailBox = $(".account-detail-box");
    if ($accountDetailBox.hasClass("active")) {
        $accountDetailBox.removeClass("active");
    } else {
        $accountDetailBox.addClass("active");
    }
});
