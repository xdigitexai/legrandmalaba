     function colorApp() {
        let getmode = localStorage.getItem("lightMode")
        if(getmode == "auto"){
           var getauto = window.matchMedia("(prefers-color-scheme: dark)").matches
           if (getauto == true){
              htmlcontent.setAttribute("class", "dark")
           } else {
              htmlcontent.setAttribute("class", "light")
           }
