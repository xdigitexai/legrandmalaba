$(document).click(function(event){
    if (!$(event.target).closest(".curency_btn").length) {
        $("#currencies-list").removeClass("active");
    }

    if (!$(event.target).closest(".header-detail-button.active-account-detail").length) {
        $(".account-detail-box").removeClass("active");
    }
});



