<body class="dashboard nightmode" id="body" >
  

  <script>
    if (localStorage.getItem('growFollowsCurrentMode')) {
      const bodyFire2 = document.getElementById('body');
      bodyFire2.classList.add('nightmode');
    }
  </script>

  <!-- Popup promotionnel mbbusiness.site -->
  <div id="mb_promo_overlay" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.65);z-index:99999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;max-width:480px;width:92%;margin:auto;padding:0;box-shadow:0 8px 40px rgba(0,0,0,0.35);overflow:hidden;position:relative;">
      <div style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);padding:28px 30px 20px;">
        <div style="text-align:center;margin-bottom:8px;">
          <span style="font-size:2.2rem;">🛍️</span>
        </div>
        <h2 style="color:#fff;text-align:center;font-size:1.15rem;font-weight:800;letter-spacing:0.5px;margin:0 0 6px;line-height:1.4;">ACHETEZ DES PRODUITS NUMÉRIQUES</h2>
        <h2 style="color:#e94560;text-align:center;font-size:1.15rem;font-weight:800;letter-spacing:0.5px;margin:0;line-height:1.4;">COURS &amp; FORMATIONS EN LIGNE</h2>
      </div>
      <div style="padding:22px 30px 26px;text-align:center;">
        <p style="color:#444;font-size:0.97rem;margin:0 0 18px;line-height:1.6;">
          Découvrez notre boutique de produits numériques, cours et formations pour développer vos compétences et votre activité en ligne.
        </p>
        <a href="https://mbbusiness.site" target="_blank" rel="noopener noreferrer"
           style="display:inline-block;background:linear-gradient(135deg,#e94560,#c0392b);color:#fff;font-weight:700;font-size:1rem;padding:12px 32px;border-radius:8px;text-decoration:none;letter-spacing:0.3px;box-shadow:0 4px 15px rgba(233,69,96,0.4);">
          Visiter mbbusiness.site &rarr;
        </a>
        <div style="margin-top:16px;">
          <button onclick="closeMbPromo()" style="background:none;border:none;color:#999;font-size:0.85rem;cursor:pointer;text-decoration:underline;">Fermer</button>
        </div>
      </div>
      <button onclick="closeMbPromo()" style="position:absolute;top:12px;right:14px;background:rgba(255,255,255,0.15);border:none;color:#fff;font-size:1.2rem;width:28px;height:28px;border-radius:50%;cursor:pointer;line-height:28px;text-align:center;">&times;</button>
    </div>
  </div>
  <script>
    (function(){
      if (!sessionStorage.getItem('mb_promo_shown')) {
        var el = document.getElementById('mb_promo_overlay');
        if (el) { el.style.display = 'flex'; }
        sessionStorage.setItem('mb_promo_shown', '1');
      }
    })();
    function closeMbPromo() {
      var el = document.getElementById('mb_promo_overlay');
      if (el) { el.style.display = 'none'; }
    }
  </script>

