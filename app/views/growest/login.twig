                                          <i class="fas fa-user"></i>
                                       </div>
                                       <div class="text">
                                          Se connecter
                                       </div>
                                    </button>
                                    
                                 </div>
                                 <div class="col-lg-6 col-md-6 col-12">
                                     {{ google_login_content }} 
                                 </div>
                              </div>
                                 
                                  
                                 <div class="col-lg-6 col-md-6 col-12">
                                    <div class="forgot__pass_phone show_phone">
