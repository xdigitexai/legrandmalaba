    $(window).scroll(function () {
      var scroll = $(window).scrollTop();

      if (scroll >= 80) {
        $("#navbar").addClass("shrink");
      } else {
        $("#navbar").removeClass("shrink");
      }

      if (scroll >= 300) {
        $("#navbar").addClass("fixed-top");
