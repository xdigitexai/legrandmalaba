      <script>
function getUrlParameter(name) {
    name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
    var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
    var results = regex.exec(location.search);
    return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));}
var serviceId = getUrlParameter('service_id');
var categoryId = getUrlParameter('category_id');
if (serviceId && categoryId) { 
    $('#neworder_services').val(serviceId).trigger('change');
    $('#neworder_category').val(categoryId).trigger('change');
    var urlWithoutParams = window.location.href.split('?')[0];
    history.replaceState({}, document.title, urlWithoutParams);
    var url = 'ajax_data/selectize?service_id=' + serviceId;
    $.ajax({
        type: 'POST',
        url: url,
        data: {
            category_id: categoryId,
            action: 'selectize'
        }
    });
}
</script>

