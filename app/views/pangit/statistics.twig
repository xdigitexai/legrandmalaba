{% if pagination["count"] > 1 %}
<div class="mt-6 flex overflow-x-auto">

        <ul class="pagination">
            {% if pagination["current"] != 1 %}
                <li>
                    <a class="btn btn-actions" href="statistics/{{ status }}/{{ pagination["previous"] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Previous">
                        <span aria-hidden="true">«</span>
                    </a>
                </li>
            {% endif %}

            {% for page in 1..pagination["count"] %}
                <li{% if page == pagination['current'] %} class="active"{% endif %}>
                    <a class="btn btn-actions" href="statistics/{{ status }}/{{ page }}{% if search %}?search={{ search }}{% endif %}">{{ page }}</a>
                </li>
            {% endfor %}

            {% if pagination['current'] < pagination['count'] %}
                <li>
                    <a class="btn btn-actions" href="statistics/{{ status }}/{{ pagination['next'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Next">
                        <span aria-hidden="true">»</span>
                    </a>
                </li>
            {% endif %}
        </ul>
        </div>
{% endif %}

