{% include 'header.twig' %}

 <!-- Main variables *content* -->
			 <main  >
				 <section id="page_banner" class="contact-us">
    <div class="container">
        <div class="row d-flex align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="banner_text_content">
                    <h4>Contact Us</h4>
                    <h1>
                        Reach Out to {{ site["site_name"] }}
                        for Your Social
                        Media Solutions
                    </h1>
                    <p>
                        At {{ site["site_name"] }}, we're always eager to connect with you and discuss how we can elevate your
                        social media presence. Whether you have questions about our services, need assistance in
                        choosing the right strategy, or want to discuss a customized plan, we're here to help.
                        Learn more about our journey and ethos on our About Us page.
                    </p>
                    <a href="/signup" class="btn btn-primary">Get Started</a>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-12">
                <div class="banner_image">
                    <img src="img/SmmEngage/Image/smm-panel-provider-in-bd.webp" class="img-fluid" alt="smm panel provider in bd">
                </div>
            </div>

        </div>
    </div>
</section>


<section id="howToContact">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="banner_text_content">
                    <h2>
                        How to Contact Us
                    </h2>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-6 col-md-6 col-12 mb-4">
                <div class="card card_contact">
                    <div class="card-body">
                        <div class="icon">
                            <img src="https://smmengage.com/img/SmmEngage/Image/contact-email-smm-panel.png" class="img-fluid" alt="contact email smm panel">
                        </div>
                        <h3>Email</h3>
                        <p>
                            For detailed inquiries, feedback, or support, email us at
                            <a href="mailto:admin@smmengage.com" class="home_link">admin@smmengage.com</a>. Our team is committed to providing timely and helpful
                            responses.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-12 mb-4">
                <div class="card card_contact">
                    <div class="card-body">
                        <div class="icon">
                            <img src="https://smmengage.com/img/SmmEngage/Image/social-media-contact-us.png" class="img-fluid" alt="social media contact us">
                        </div>
                        <h3>Social Media</h3>
                        <p>
                            Follow us, engage with us, and reach out through our social media channels. We're
                            active
                            and responsive on platforms like Facebook, Twitter, Instagram, LinkedIn, and more.
                            It's
                            not just a way to contact us; it's a window into the work we do for our clients.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="text-center">
                    <p class="mb-3">
                        We value every interaction and are dedicated to providing you with the information and
                        support you need. <br> At {{ site["site_name"] }}, your digital marketing success is our priority, and we
                        look
                        forward to playing a part in your journey to social media excellence.
                    </p>
                    <a href="/about-us" class="btn btn-primary">More About Us</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="followSocialMedia">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="follow_section_wraper">
                    <div class="default__text__content text-center text_wrap_cta">
                        <h2 class="text-white">
                            Follow Us on Social Media
                        </h2>
                        <div class="d-flex justify-content-center mb-3">
                            <ul class="social_media_links">
                                <li>
                                    <a href="https://www.facebook.com/" class="social_link" target="_blank">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/facebook-smmpanel.png" class="img-fluid"
                                            alt="facebook smm panel icon">
                                    </a>
                                </li>
                                <li>
                                    <a href="" class="social_link">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/instagram-smmpanel.png" class="img-fluid"
                                            alt="instagram smm panel icon">
                                    </a>
                                </li>
                                <li>
                                    <a href="https://twitter.com/" class="social_link" target="_blank">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/twitter-smmpanel.png" class="img-fluid"
                                            alt="twitter smm panel icon">
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.youtube.com/" class="social_link" target="_blank">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/youtube-smmpanel.png" class="img-fluid"
                                            alt="youtube smm panel icon">
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.linkedin.com/company/" class="social_link" target="_blank">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/linkedin-smmpanel.png" class="img-fluid"
                                            alt="linkedin smm panel icon">
                                    </a>
                                </li>
                                <li>
                                    <a href="https://www.pinterest.com/" target="_blank" class="social_link">
                                        <img src="https://smmengage.com/img/SmmEngage/Images/pinterest-smmpanel.png" class="img-fluid"
                                            alt="pinterest icon">
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <p class="text-white">
                            Get in touch with {{ site["site_name"] }} today and take the first step towards transforming
                            <br>
                            your brand's social media narrative. We're more than just a service <br>
                            provider; we're your partner in digital growth!
                        </p>
                        <a href="/signup" class="btn btn-white">Signup Now</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
			 </main>
      
