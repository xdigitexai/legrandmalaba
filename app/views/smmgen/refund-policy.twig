{% include 'header.twig' %}






 <!-- Main variables *content* -->
			 <main  >
				 <section id="page_top_banner">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="page__title__all">
                    <h1>Refund Policy</h1>
                    <p>
                        At <a href="/" class="home_link">{{ site["site_name"] }}</a>, customer satisfaction is our main
                        focus. Kindly
                        review our Refund Policy for clear
                        instructions on returns and refunds. Your trust is invaluable, and we aim for a positive
                        experience.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


<section id="terms_content">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="tems_items">
                    <h3>✅ Introduction</h3>
                    <p class="mb-3">
                        At {{ site["site_name"] }}, customer satisfaction is our top priority. This refund policy outlines conditions for
                        issuing refunds. Once you complete a deposit on {{ site["site_name"] }}, it cannot be reversed, and refunds
                        to your payment method won't be processed. Your balance should be used for website orders. In
                        certain cases, you can request a refund for any remaining balance through your chosen payment
                        gateway. Refunds are processed within 24-72 hours. Note that PayPal and card payments are
                        non-refundable.
                    </p>
                </div>

                <div class="tems_items">
                    <h3>✅ Eligibility for Refund</h3>
                    <p class="mb-3">
                        A. Non-Delivery of Service: If a purchased service isn't delivered as promised, you may qualify
                        for a refund.
                    </p>
                    <p>
                        B. Service Issues: If the service significantly deviates from the description or doesn't meet
                        standards, you can request a refund.
                    </p>
                </div>

                <div class="tems_items">
                    <h3>✅ Non-Refundable Circumstances</h3>
                    <p class="mb-3">
                        A. Change of Mind: Refunds are not applicable if you change your mind post-purchase.
                    </p>
                    <p>
                        B. Misuse or Breach: No refunds for accounts terminated or suspended due to Terms of Service
                        violations.
                    </p>
                </div>


                <div class="tems_items">
                    <h3>✅ Partial Refunds</h3>
                    <p class="mb-3">
                        Partial refunds may be approved if:
                    </p>
                    <ul style="list-style-type: none; margin: 0px;">
                        <li>A. You've used some, but not all, purchased services.</li>
                        <li>B. The delivered service only partially meets the description.</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-12">
                <div class="tems_items">
                    <h3>✅ Refund Process</h3>
                    <p class="mb-3">
                        To initiate a refund:
                    </p>
                    <ul style="list-style-type: none; margin: 0px;">
                        <li>A. Contact our support team at <a href="mailto:admin@smmengage.com"
                                class="Contact_us">Email us</a> within 10 days of purchase.</li>
                        <li>B. Provide a valid reason and necessary evidence.</li>
                        <li>C. Our team will review and respond within 10 working days.</li>
                    </ul>
                </div>

                <div class="tems_items">
                    <h3>✅ Refund Mode</h3>
                    <p class="mb-3">
                        Refunds are issued using the original payment method within 5-10 business days.
                    </p>
                </div>

                <div class="tems_items">
                    <h3>✅ Late or Missing Refunds</h3>
                    <p class="mb-3">
                        Check with your bank or credit card company if your expected refund is delayed. If issues
                        persist, contact us at <a href="mailto:admin@smmengage.com"
                            class="home_link">Email Us</a>.
                    </p>

                </div>


                <div class="tems_items">
                    <h3>✅ Changes to Refund Policy</h3>
                    <p class="mb-3">
                        {{ site["site_name"] }} reserves the right to modify this policy. Updates will be posted on this page. Users are
                        advised to check for updates regularly.
                    </p>
                </div>

                <div class="tems_items">
                    <h3>✅ Contact Us</h3>
                    <p class="mb-3">
                        For inquiries, clarifications, or feedback on this policy, please <a
                            href="/contact-us" class="Contact_us">reach out to us</a>.
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>
			 </main>




























