{% include 'header.twig' %}


 <!-- Main variables *content* -->
    <main>
        <section id="signup_wraper">
    <div class="signup_left">
        <div class="signup__image">
            <img src="https://res.cloudinary.com/dmentewxe/image/upload/v1704035342/smmpanelbdlab/SMMSUN-NEW-V2/IMG/signup-best-smm-panel-in-bangladesh_1_zeonep_bmbtiq.png" class="img-fluid"
                alt="">
        </div>
    </div>
    <div class="signup_right">
        <div class="container">
            <div class="row">
                <div class="col-lg-9 col-md-12 col-12">
                    <div class="signup_title">
                        <h1 class="text-black">Reset password</h1>
                    </div>
                    <div class="signup__form">
                        
                              
      {% if errorText %}
        <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ errorText }}
        </div>
      {% endif %}
      {% if successText %}
        <div class="alert alert-dismissible alert-success">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ successText }}
        </div>
      {% endif %}
      
                        <form  method="post" action="">
                                                                                    <div class="form-group has_icon">
                              <span class="icon"><img src="https://res.cloudinary.com/dmentewxe/image/upload/v1704035639/smmpanelbdlab/SMMSUN-NEW-V2/IMG/mail-user_cjpfne.png"
                                class="img-fluid icon" alt=""></span>
                              <input type="email" class="form-control" id="email" placeholder="Email" name="email">
                            </div>
                                                         {% if captcha %}
            <div class="form-group">
              <div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div>
            </div>
          {% endif %}
                                                        <button type="submit" class="btn btn-primary w-100">Send</button>

                          </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

  <script src="https://www.google.com/recaptcha/api.js?hl=en"></script>

    </main>
    
    
 {% include 'footer.twig' %}