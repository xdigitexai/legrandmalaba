    <script>

    // User Common Variables
    const pointApiUrl = 'https://app.smmxz.com/api/point';
    const point_user_id = 13108;
    const point_username = "intongisidrojr";
    const point_email = "intongisidrojr@gmail.com";
    const totalspend = 0;

    // Updateing the Point to server each reloads
    $.post(pointApiUrl, { 'action': 'add_points', 'user_id': point_user_id, 'username': point_username, 'email': point_email, 'spent': totalspend }, function (response) {
      console.log('user point data updated to server.');
    });

    // Showing to DOM 

    setTimeout(function () {
      fetch(pointApiUrl, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          'action': 'get_points',
          'username': point_username,
          'user_id': point_user_id
        }),
      }).then((res) => res.json())
        .then((data) => {
          console.log(data);

			var userPoint = parseFloat(data.spent).toFixed(2);

          if (totalspend >= 5000 && totalspend < 10000) {
            // Frequent 
            var userBonus = 1.25;
          } else if (totalspend >= 10000 && totalspend < 25000) {
            // Elite
            var userBonus = 1.50;
          } else if (totalspend >= 25000 && totalspend < 50000) {
            // VIP
            var userBonus = 1.75;
          } else if (totalspend >= 50000) {
            // Master
            var userBonus = 2;
          }
          else {
            var userBonus = 1;
          }

            var userMoney = parseFloat((userPoint) * (userBonus) / 100).toFixed(2);

            console.log()

          // dom for to layout
          $('#data_points').text(userPoint);
          $('#data_balance').text(userMoney);

		   // dom for to popup
		   $('#points2').text(userPoint);
          $('#point_balance2').text(userMoney);


          // dom for dashboard 
          $('#points').text(userPoint);
          $('#point_balance').text(userMoney);

        })
        .catch((err) => console.log(err));
    }, 1000);

  </script>

