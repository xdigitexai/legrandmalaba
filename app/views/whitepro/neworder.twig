    padding-bottom: 0.3125rem; /* Use rem for better scalability */
}

.service-dashboard ul {
    list-style: none; /* Remove default list styling */
    padding: 0; /* Remove padding */
    margin: 0; /* Remove margin */
}

.service-dashboard li {
    background-color: #fff; /* White background */
    border: 1px solid #e0e0e0; /* Border for items */
    border-radius: 0.3125rem; /* Rounded corners */
    padding: 0.5rem; /* Use rem for better scalability */
    margin: 0.3125rem 0; /* Use rem for better scalability */
    transition: background-color 0.2s; /* Smooth background color change */
}

.service-dashboard li:hover {
    background-color: #f0f0f0; /* Change background on hover */
}

.service-dashboard li::before {
    content: "✔️"; /* Checkmark */
    margin-right: 0.3125rem; /* Space between icon and text */
    color: #007bff; /* Checkmark color */
}
</style>
