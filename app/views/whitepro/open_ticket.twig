<!-- Main variables *content* -->



  		<div class="hiddenTitle">
  <div id="appTt">Ticket Detail</div>
  <div id="appTx">We're the best!</div>
</div>
<div class="appContent">
  <section class="sd-head">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-auto">
          <a href="/tickets" class="btn btn-secondary btn-rounded">
            <i class="ri-arrow-left-line me-3"></i>
            <span class="text">Back to Tickets</span>
          </a>
        </div>
        <div class="col-md-auto col-12 ms-auto">
          <div class="sd-tid">
            <h2 class="title">{{ messageList['ticket']['subject'] }}</h2>
            <div class="tid">{{ messageList['ticket']['ticket_id'] }}</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="sd-ticket">
    <div class="container">
      <div class="row">
        <div class="col-xxl-4 col-lg-5 col-md-6 mb-4 order-2 order-md-1 mt-4 mt-md-0">
          <div class="card scd-ri-box">
            <div class="card-body">
        
                            <div class="scd-id">ID: {{ messageList['ticket']['ticket_id'] }}</div>
              <div class="scd-title">{{ messageList['ticket']['subject'] }}</div>
              <p class="scd-text">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum
                has been the industry's standard dummy text ever since the 1500s</p>
            </div>
          </div>
          <div class="card card-border mb-3">
            <div class="card-body sd-cb">
              <div class="row">
                <div class="col">
                  <h3 class="tc-ti-title">Subject</h3>
                </div>
                <div class="col-auto">
                  <div class="tc-ti-text danger-bg">{{ messageList['ticket']['subject'] }}</div>
                </div>
              </div>
            </div>
          </div>
          <div class="card card-border mb-3">
            <div class="card-body sd-cb">
              <div class="row">
                <div class="col">
                  <h3 class="tc-ti-title">Priority</h3>
                </div>
                <div class="col-auto">
                  <div class="tc-ti-text">High</div>
                </div>
              </div>
            </div>
          </div>

          <div class="card card-border mb-3">
            <div class="card-body sd-cb">
              <div class="row">
                <div class="col">
                  <h3 class="tc-ti-title">Avg. Response Time</h3>
                </div>
                <div class="col-auto">
                  <div class="tc-ti-text pink-bg">0-4 Hours</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xxl-8 col-lg-7 col-md-6 order-1 order-md-2">
          <div class="card card-border">
            <div class="card-body">
              <div class="schat-body">
                <div class="schat-chat-body">
                  <div class="schat-body-content">
                                        {% if messageList %}
                {% for message in messageList %}
                  {% if message["support"] == 1 %}    <div class="ticket-message-block ticket-message-right">
                      <div class="ticket-msg-container">
                        <div class="ticket-msg">{{ message["message"] }}</div>
                        <div class="date-time">{{ user["username"] }} {{ message["time"] }}</div>
                    </div> </div>{% elseif message["subject"] %}
                  {% else %}
                                               <div class="ticket-message-block ticket-message-left">
                      <div class="ticket-msg-container">
                        <div class="ticket-msg">{{ message["message"] }}</div>
                        <div class="date-time">support {{ message["time"] }}</div>
                      </div>
                    </div> {% endif %}

                {% endfor %}
              {% endif %}
                                              </div>
                </div>
                 {% if messageList['ticket']['canmessage'] == 2 %}  
              <form  method="post" action="/tickets/{{ messageList['ticket']['ticket_id'] }}">
                                <div class="schat-input">
                  <div class="schat-msg-input">
                  
                 
                     <input type="text" name="message" >
               
                
                <button type="submit" class="btn btn-primary btn-sm btn-rounded sd-send-btn me-2"><span class="d-none d-md-inline-block">Submit</span>
                      <i class="ri-send-plane-fill fw-400 ms-md-2"></i>
                    </button>
                   </div> 
                </div>
              </form>{% endif %}
            </div>
          </div>
              </div>
    </div>
  </div>
</div>








{% include 'footer.twig' %}