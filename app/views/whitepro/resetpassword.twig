{% include 'header.twig' %}

<div class="naHead" style="padding-top: 0px;">
  <div class="naHdCt">
    <div class="container">
      <div class="blog-head">
      
      </div>
    </div>
  </div>
</div>
<section class="blogs">
   <section class="dashboard-head-wrapper">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 mb-4">
          <div class="card card-border">
            <div class="card-header">
              <div class="row align-items-center">
                <div class="col-md">
                  <h3 class="card-title">Reset password</h3>
                  <p class="card-h-text">reset</p>
                </div>
              </div>
            </div><!-- ./card-header -->
            <div class="card-body">
   {% if errorText %}
            <div class="alert alert-dismissible alert-danger ">
              <span class="icon icon-circle" data-dismiss="alert">×</span>
              {{ errorText }}
            </div>
            {% endif %}
      {% if successText %}
            <div class="alert alert-dismissible alert-success ">
             <span class="icon icon-circle" data-dismiss="alert">×</span>
              {{ successText }}
            </div>
             {% endif %}
          <form  method="post" action="">
                                    <div class="form-group">
              <label for="email" class="control-label">{{ lang['resetpassword.user'] }}</label>
              <input type="text" class="form-control" id="name" name="user" value="{{ data['user'] }}" placeholder="{{ lang['resetpassword.user.placeholder'] }}">
            </div>
                        {% if captcha %}  <div class="g-recaptcha form-group" data-sitekey="{{ captchaKey }}"></div>{% endif %}
                        <button type="submit" class="btn btn-primary  mt-3">Send</button>
            
          </form>
        </div>
      </div>
    </div>
  </div>

{% include 'footer.twig' %}