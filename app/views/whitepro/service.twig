<div class="row">
                <div class="col">
                    <div class="services-list__table">
                        <div class="table-bg component_table ">
                            <div class="table-wr table-responsive editor__component-wrapper">
                                <table class="table" id="service-table"> 
                                    <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th class="nowrap">Service</th>
                                        <th class="nowrap">Rate for 1000</th>
                                        <th class="nowrap">Mininmum / Maximum</th>
                                        <th class="nowrap" nowrap>
                                                <div class="d-flex align-items-center">
                                                    <span>Average Time</span>
                                                    <span class="ml-1 mr-1 fa fa-exclamation-circle" data-toggle="tooltip" data-placement="top" title="The average time is based on 10 latest completed orders per 1000 quantity."></span>
                                                </div>
                                            </th>
                                     <th class="hidden-xs hidden-sm service-description__th">Service <br> Description</th> </tr>
                                    </thead>
                                    <tbody>
            

                                       {% for category in serviceCategory %}
                                            <tr class="services-list-category-title" data-filter-table-category-id="{{ category["category_id"] }}">
                                                <td colspan="7">
                                                  <div class="w-100 ">
                                                       <div style="border-radius:10px;" class="style-bg-primary-alpha-20 style-text-primary services-category p-3">
                                                          <strong> {{ category["category_name"] }}</strong>
                                                       </div>
                                                   </div>
                                                </td>
                                            </tr>


                                                

                         {% for service in category['services'] %}
                  <tr data-filter-table-category-id="{{ category["category_id"] }}">
                    <td data-label="ID" data-filter-table-service-id="{{ service["service_id"] }}"><span id="service-{{ service["service_id"] }}">{{ service["service_id"] }}</span>
                                        <a>
                                            <span
                                                data-clip="true"
                                                title="Service id copied"
                                                data-clipboard-action="copy"
                                                data-clipboard-target="#service-{{ service["service_id"] }}"
class="fas fa-clone"></span>
                                        </a></td>
                    <td data-label="Service" class="table-service" data-filter-table-service-name="true">{{ service["service_name"] }}</td>
<td><span class="badge" style="background:#13e760e0;">

{% if user["auth"] == "1" %} 
{{service["service_price"]}} PER 1K

{% else %}
{{service["without_login_service_price"]}} PER 1K
{% endif %}
    </span></td>

<td data-th="Min" data-column="column3"><span class="badge" style="background:#e7132be0;">{{ service["service_min"] }} / {{ service["service_max"] }}</span></td>
                    <td>{{ service["time"] }}</td>
                    <td>
                     <!-- Modal -->
                        <div class="modal fade" id="servis{{ service["service_id"] }}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                          <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                              <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">{{ service["service_name"] }} </h5> 
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                  <span aria-hidden="true">×</span>
                                </button>
                              </div>
                              <div class="modal-body text-left">
                                <p class="detail-data details-split-959"> {{ service["service_description"] }}</p>
                              </div>
                              <div class="modal-footer">
                                <a class="btn btn-big-secondary" href="/neworder" style="width:70%">Create Order</a>
                                <button type="button" class="btn btn-big-secondary" data-dismiss="modal">Okay</button>
                              </div>
                            </div>
                          </div>
                          {% if service["service_description"]  %}
                        </div><a href="javascript:void(0)" class="btn btn-actions " data-toggle="modal" data-target="#servis{{ service["service_id"] }}">
                         View
                      </a>
                  {% endif %} 
                        </td>
                  </tr>
                {% endfor %}
              {% endfor %}
          </tbody>
        </table>
      </div></br></br>
