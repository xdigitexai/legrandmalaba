{% include 'header.twig' %}


<div class="hiddenTitle">
		<div id="appTt">
			Services

		</div>
		<div id="appTx">
			We're the best!
		</div>
	</div>
	
	<div class="appContent" style="margin-top: 150px;">
		<section class="pt-4">
			<div class="container">
				<div class="card card-border">
					<div class="card-body p-3">
						<div class="row align-items-center">
							<div class="col-md-auto col-12">
								<div class="dropdown">
									<button class="btn btn-secondary btn-sm btn-100 dropdown-toggle dd-btn" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
										<div class="d-flex fw-400">
											<i class="ri-filter-2-line me-2"></i>
											Filter Services
											<span></span>
											<i class="ri-arrow-down-s-line ms-auto ms-md-3"></i>
										</div>
									</button>
									<ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1" style="max-height: 300px;overflow-y: auto;">
										<li>
											<a class="dropdown-item"  data-filter-category-id="All">All</a>
										</li>
																																{% for category in serviceCategory %}
                                                                                                                                                                                                <a class="dropdown-item" href="services#" data-filter-category-id="{{ category["category_id"] }}" data-filter-category-name="{{ category["category_name"] }}">{{ category["category_name"] }}</a>{% endfor %}


                    	</ul>
								</div>
							</div>
							
							
                              	<!-- ./col -->
							<div class="col-md-auto ms-md-auto ms-md-0 col-12 mt-3 mt-md-0 mb-3 mb-md-0">
								<div class="dropdown">
									<button class="btn btn-outline btn-100 btn-sm dropdown-toggle dd-btn" type="button" id="currencyDdF" data-bs-toggle="dropdown" aria-expanded="false">
										<div class="d-flex fw-400">
											<span>
                                                 {{site_base_currency}}
                        											</span>
											<i class="ri-arrow-down-s-line ms-auto ms-md-3"></i>
										</div>
									</button>
									<div class="dropdown-menu w-100" id="curr_anchor">
{{ without_login_currencies_item }}

</div>
								</div>
							</div>
							<!-- ./col -->
							<div class="col-lg">
								<div class="search-services">
									<div class="icon">
										<i class="ri-search-line"></i>
									</div>
									<input type="text" class="textbox" name="query" id="filterServicesInput" placeholder="Search in services" data-search-service="#service-table"></div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<div class="container">
			<div class="nothing-found mt-4" style="display:none">
				<div class="card card-border">
					<div class="card-body p-4 p-lg-5 text-center">
						<div style="font-size: 64px">
							<i class="ri-search-eye-line w-color"></i>
						</div>
						<h3>
							Nothing found

						</h3>
						<p>
							We searched everywhere but couldn't find anything. Try with different keywords.

						</p>
						<div class="text-center d-none">
							<a href="/" class="btn btn-seconday">
								Creat
                              e request for


								<span id="search-text-write">
								</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>


	<section class="pt-4">
			<div class="container">
				<div class="services-head-row">
					<div class="si-wrapper">
						<div class="service-item mb-4">
							<div id="service-table" class="s-row s-title">
                                
                                    <thead>
                                    <tr>
                                       <div class="s-col s-col-sm">
									ID
								</div>
								<div class="s-col s-col-sm d-none">
									Fav
								</div>
								<div class="s-col s-title">
									Service
								</div>
								<div class="s-col s-col-md">
									Rate per 1000
								</div>
								<div class="s-col s-col-md">
									Min order
								</div>
								<div class="s-col s-col-md">
									Max order
								</div>
								<div class="s-col s-col-lg">
									Average time
								</div>
								<div width="7%" class="s-col s-col-md">
									Description
								</div>
								
									</div>
							</div>
						</div>
					</div>
				</div>
                                  
                                    
            

              {% for category in serviceCategory %}
              
              <div class="category-card" data-category="Blue Badge Verification Services"  data-filter-table-category-id="{{ category["category_id"] }}">
							<div class="si-header">
								<h2 class="si-title">
                                                                                                           {{ category["category_name"] }}
                                                      </h2>
							</div>
{% for service in category['services'] %}
							<div class="">
							    
								<div class="services-wrapper">
																
									<div class="si-wrapper">
										<div class="service-item">
											<div class="s-row">
												<div class="s-col s-col-sm s-col-id">
													<span class="sp-serv-sm">
													 {{ service["service_id"] }}
													</span>
												</div>
												<div class="s-col s-col-sm s-col-fav d-none">
													<button class="btn btn-light text-dark smmspot-fav-btn" data-smmspot="fav" data-service="10000">
														<i class="far fa-star smmspot-fni" aria-hidden="true"></i>
														<i class="fas fa-star smmspot-fic" aria-hidden="true"></i>
														<i class="fas fa-spinner fa-spin smmspot-fil" aria-hidden="true"></i>
													</button>
												</div>
												<div class="s-col s-title">
													<span class="sp-serv-title">
													{{ service["service_name"] }}
													</span>
												</div>
												<div class="s-col s-col-md s-col-c" data-title="Per 1000">
													<span class="sp-serv-sm">
														≈ {{ service["without_login_service_price"] }}  
													</span>
												</div>
												<div class="s-col s-col-md s-col-c" data-title="Min">
													<span class="orlc min">
														{{ service["service_min"] }}
													</span>
												</div>
												<div class="s-col s-col-md s-col-c" data-title="Max">
													<span class="sp-serv-sm">
													{{ service["service_max"] }}
													</span>
												</div>
																									<div class="s-col s-col-lg s-col-avtime" data-title="Average Time">
														<span class="sp-serv-sm">
														{{ service["time"] }}
														</span>
													</div>
																								 <div class="modal fade" id="servis{{ service["service_id"] }}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                          <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                              <div class="m-header modal-header">
                                  
                                  
				<div class="row align-items-center">
					<div class="col">
						<h2 class="m-title" id="serviceModalTitle">{{ service["service_name"] }}</h2>
						<p class="m-sub-title">
							ID:


							<span id="serviceModalId">{{ service["service_id"] }}</span>
						</p>
					</div>
					<div class="col-auto">
						<button type="button" class="m-close" data-dismiss="modal" aria-label="Close">
							<i class="ri-close-line"></i>
						</button>
					</div>
				</div>
			
                                  
                               <!-- <h5 class="modal-title" id="exampleModalLabel">{{ service["service_name"] }} </h5> -->
                             
                              </div> 
                              
                              <div class="m-body">
				<div id="serviceModalText" class="mb-4"> {{ service["service_description"] }}</div>
			<!--	<span id="serviceModalLink"><a href="/?service_id={{ service["service_id"] }}" class="btn btn-primary btn-100">Buy Service</a></span>-->
			</div>
                              
                              
                            <!--  <div class="modal-body text-left">
                                <p class="detail-data details-split-959"> {{ service["service_description"] }}</p>
                              </div> -->
                             
                            </div>
                          </div>
						  
                        </div><a href="javascript:void(0)" class="btn btn-primary btn-rounded btn-100 btn-sm " data-toggle="modal" data-target="#servis{{ service["service_id"] }}">
                         View
                      </a>
												</div>
											</div>
										</div>
										<!-- ./service-item -->
									</div>
									<!-- ./si-wrapper -->
{% endfor %}
										 {% endfor %}					</div>
							<!-- ./services-wrapper -->
						</div>
					</div>

	
	
	
	
	
	
	
	
	
	




{% include 'footer.twig' %}