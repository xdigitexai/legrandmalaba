{% include 'header.twig' %}

<div class="naHead" style="padding-top: 0px;">
  <div class="naHdCt">
    <div class="container">
      <div class="blog-head">
       
      </div>
    </div>
  </div>
</div>
<section class="blogs">
   <section class="dashboard-head-wrapper">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 mb-4">
          <div class="card card-border">
            <div class="card-header">
              <div class="row align-items-center">
                <div class="col-md">
                  <h3 class="card-title">Reset New password</h3>
                  <p class="card-h-text">reset</p>
                </div>
              </div>
            </div> <!-- ./card-header -->
            <div class="card-body">  
          <form  method="post" action="">
          {% if errorText %}
            <div class="alert alert-dismissible alert-danger ">
              <span class="icon icon-circle" data-dismiss="alert">×</span>
              {{ errorText }}
            </div>
            {% endif %}
      {% if successText %}
            <div class="alert alert-dismissible alert-success ">
             <span class="icon icon-circle" data-dismiss="alert">×</span>
              {{ successText }}
            </div>
             {% endif %}
            <h3>Set new password</h3>
                                    <div class="form-group">
              <label for="username" class="control-label">Username</label>
              <input type="text" class="form-control" id="username" value="{{ user['username'] }}" placeholder="{{ user['username'] }}" readonly>
            </div>
            <div class="form-group">
              <label for="password_new" class="control-label">New password</label>
              <input type="password" class="form-control" id="password_new" name="password" placeholder="New Password" required>
            </div>
            <div class="form-group">
              <label for="password_confirm" class="control-label">Confirm new password</label>
              <input type="password" class="form-control" id="password_confirm" name="password_again" placeholder="Confirm Password" required>
            </div>
            <button type="submit" class="btn btn-primary mt-3">Submit</button>
            
          </form>
        </div>
      </div>
    </div>
  </div>
  
  {% include 'footer.twig' %}