<style>
  #block_134 {
    position: relative;
    z-index: auto;
    width: 100%;
    display: flex;
    min-height: auto;
    align-items: flex-start;
    padding-top: 30px;
    padding-bottom: 30px;
    color: var(--text-dark);
}

#block_134 .block-bg {
    background: var(--color-id-131);
}

#block_134 .video-container {
    display: flex;
    align-items: center;
    justify-content: center;
}

#block_134 .video-block {
    max-width: 800px; /* Maximum width for larger screens */
    width: 100%; /* Full width for smaller screens */
    height: 0; /* Set height to 0 for aspect ratio */
    padding-top: 20%; /* 16:9 Aspect Ratio */
    position: relative; /* Position relative for absolute children */
    overflow: hidden; /* Hide overflow */
}

#block_134 .video-block .video-frame {
    position: absolute; /* Position absolute to fill the parent */
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    box-shadow: none;
    border-radius: 4px; /* Rounded corners */
    border: 3px solid var(--color-id-158); /* Border color */
}

#block_134 .video-block iframe {
    position: absolute; /* Position absolute to fill the frame */
    top: 0;
    left: 0;
    width: 100%; /* Full width */
    height: 100%; /* Full height */
    border: none; /* Remove default border */
}

/* Responsive styles */
@media (max-width: 499px) {
    #block_134 .video-block {
        padding-top: 56.25%; /* Maintain aspect ratio */
    }
}
</style>

