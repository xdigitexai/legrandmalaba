  <style>
.service-dashboard {
    background-color: #f9f9f9; /* Light background */
    border: 1px solid #e0e0e0; /* Softer border */
    padding: 1rem; /* Use rem for better scalability */
    margin-top: 1.25rem; /* Use rem for better scalability */
    border-radius: 0.5rem; /* Rounded corners */
    box-shadow: 0 0.125rem 0.625rem rgba(0, 0, 0, 0.1); /* Subtle shadow */
    max-height: 250px; /* Set a max height for scrolling */
    overflow-y: auto; /* Enable vertical scrolling */
}

.service-dashboard h4 {
    font-size: 1.125rem; /* Use rem for better scalability */
    color: #333; /* Dark text */
    margin-bottom: 0.625rem; /* Use rem for better scalability */
    border-bottom: 2px solid #000; /* Bottom border */
    padding-bottom: 0.3125rem; /* Use rem for better scalability */
}

.service-dashboard ul {
    list-style: none; /* Remove default list styling */
    padding: 0; /* Remove padding */
    margin: 0; /* Remove margin */
}

.service-dashboard li {
    background-color: #fff; /* White background */
    border: 1px solid #e0e0e0; /* Border for items */
    border-radius: 0.3125rem; /* Rounded corners */
    padding: 0.5rem; /* Use rem for better scalability */
    margin: 0.3125rem 0; /* Use rem for better scalability */
    transition: background-color 0.2s; /* Smooth background color change */
}

.service-dashboard li:hover {
    background-color: #f0f0f0; /* Change background on hover */
}

.service-dashboard li::before {
    content: "✔️"; /* Checkmark */
    margin-right: 0.3125rem; /* Space between icon and text */
    color: #007bff; /* Checkmark color */
}
</style>
<style>
#unique-dropdown{max-height: 300px;border-radius: 8px;margin-top:8px;border-left-width: 0px;border-right-width: 0px;border-top-width: 0px;border-bottom-width: 0px;border-color: transparent;border-style: solid;box-shadow: 0 12px 24px 12px rgba(0, 0, 0, 0.2);overflow-y: auto;display: block;position: absolute;left:auto;max-width:100%;width: 86%;background:white;z-index: 1;}@media(min-width:776px){ #unique-dropdown{width: 93%;}}@media(min-width:991px){ #unique-dropdown{width: 92.4%;}}.selectme {padding: 3px 10px;cursor: pointer;list-style-type: none; }.selectme:hover {background-color: #f2f2f2;}.highlight {font-weight: bold; }.form-group .search-dropdown .input-wrapper .input-wrapper__prepend, .form-group .search-dropdown .input-wrapper .input-wrapper__append {position: absolute;background: none;border: none;top: 50%;transform: translateY(-50%);padding: 0px 15px;color: var(--form_group_icon_color);}.form-group .search-dropdown .input-wrapper .input-wrapper__prepend:hover, .form-group .search-dropdown .input-wrapper .input-wrapper__append:hover {opacity: 0.5;}.form-group .search-dropdown .input-wrapper .input-wrapper__prepend:hover, .form-group .search-dropdown .input-wrapper .input-wrapper__append:focus {outline:none;}.form-group .search-dropdown .input-wrapper .input-wrapper__append {font-size: 12px;right: 3px;display: none;}
</style>
