<script>
document.addEventListener('DOMContentLoaded', function() {
    const scrollArea = document.getElementById('service_descriptions');
    
    // Example content to ensure scrolling
    for (let i = 0; i < 20; i++) {
        const p = document.createElement('p');
        p.textContent = 'Item ' + (i + 1);
        scrollArea.appendChild(p);
    }

    // Check if scrolling works
    scrollArea.addEventListener('scroll', function() {
        console.log('Scrolling...');
    });
});
</script>

